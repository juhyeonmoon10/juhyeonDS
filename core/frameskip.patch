 void GPU3D::VCount215(GPU& gpu) noexcept
 {
+    if (SkipRender && !(gpu.GPU2D_A.CaptureCnt & (1u<<31)))
+    {
+        SkippedSinceRender = true;
+        return;
+    }
+    if (SkippedSinceRender)
+    {
+        // the scene changed while frames were skipped: the cached picture is stale
+        RenderFrameIdentical = false;
+        SkippedSinceRender = false;
+    }
     CurrentRenderer->RenderFrame(gpu);
 }
 
